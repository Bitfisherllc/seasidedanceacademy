---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { newsPosts } from '../data/news';
import { pages, site } from '../data/site';
import { albums, gallery } from '../data/albums';
import newsPage from '../data/news-page.json';

const posts = [...newsPosts].sort((a, b) => Date.parse(b.date) - Date.parse(a.date));

function newsAlt(post: { text: string; date: string }) {
  const text = post.text.replace(/\s+/g, ' ').trim();
  if (!text) return `Seaside Dance Academy Facebook post from ${post.date}`;
  const sentence = text.split(/(?<=\.)\s/)[0];
  return sentence.length <= 140 ? sentence : `${sentence.slice(0, 137).trimEnd()}…`;
}
const photoAlbums = [
  { title: 'Gallery', images: gallery.map((item) => item.src) },
  ...albums.map((album) => ({
    title: album.title,
    images: album.images.length ? album.images : [album.image],
  })),
];
---

<Base title={pages.news.title} description={pages.news.description} canonical="/seaside-news.html">
  <Hero slot="hero" icon="newspaper" image={newsPage.banner.src} focus={newsPage.banner.focus} photoKey="news" quoteKey="news">
    <button slot="edit" class="home-edit-btn" type="button" data-edit="banner">Edit</button>
  </Hero>
  <section class="section">
    <div class="container home-block">
      <button class="home-edit-btn" type="button" data-edit="copy">Edit</button>
      <h1 class="center">
        <span class="fs-32" data-news="title">{newsPage.title}</span>
      </h1>
      <p class="copy center trust-lead" data-news="lead">{newsPage.lead}</p>
      <p class="copy center" data-news="account">{newsPage.account}</p>
      <div class="news-list" data-news-list>
        {posts.map((post) => (
          <article class="news-post">
            <span class="news-photo">
              <img src={post.image} alt={newsAlt(post)} width="960" height="540" loading="lazy" />
              <i class="fa-solid fa-play album-play" aria-hidden="true"></i>
            </span>
            {post.date && (
              <span class="news-meta">
                <span><i class="fa-solid fa-calendar-days icon" aria-hidden="true"></i>{post.date}</span>
              </span>
            )}
            {post.text && <span class="news-copy">{post.text}</span>}
            <a class="btn news-facebook" href={post.href} target="_blank" rel="noopener noreferrer">
              <span><i class="fa-brands fa-facebook icon" aria-hidden="true"></i>View on Facebook</span>
            </a>
          </article>
        ))}
      </div>
      <p class="center"><a class="btn" href={site.facebook} target="_blank" rel="noopener noreferrer"><span><i class="fa-brands fa-facebook icon" aria-hidden="true"></i><span data-news="button">{newsPage.button}</span></span></a></p>
    </div>
  </section>
  <dialog class="home-edit-dialog" id="news-edit-dialog">
    <form id="news-edit-form" onsubmit="event.preventDefault()">
      <h2 id="news-edit-title">Edit</h2>
      <p class="home-edit-note" id="news-edit-note"></p>
      <div id="news-edit-fields"></div>
      <p class="home-edit-status" id="news-edit-status" role="status"></p>
      <div class="home-edit-actions">
        <button class="home-edit-save" type="button">Save</button>
        <button class="home-edit-cancel" type="button" id="news-edit-cancel">Cancel</button>
      </div>
    </form>
  </dialog>
</Base>

<script define:vars={{ photoAlbums }}>
  window.__pageAlbums = photoAlbums;
</script>

<script define:vars={{ saved: newsPosts }}>
  const list = document.querySelector('[data-news-list]');

  function idFrom(href) {
    const match = String(href || '').match(/\/reel\/(\d+)/);
    return match ? match[1] : '';
  }

  function posted(post) {
    const value = Date.parse(post.date || '');
    return Number.isNaN(value) ? 0 : value;
  }

  function card(post) {
    const article = document.createElement('article');
    article.className = 'news-post';
    const photo = document.createElement('span');
    photo.className = 'news-photo';
    const image = document.createElement('img');
    image.src = post.image;
    const caption = String(post.text || '').replace(/\s+/g, ' ').trim();
    const sentence = caption ? caption.split(/(?<=\.)\s/)[0] : '';
    image.alt = sentence
      ? (sentence.length <= 140 ? sentence : `${sentence.slice(0, 137).trim()}…`)
      : `Seaside Dance Academy Facebook post from ${post.date || 'the studio'}`;
    image.width = 960;
    image.height = 540;
    image.loading = 'lazy';
    const icon = document.createElement('i');
    icon.className = 'fa-solid fa-play album-play';
    icon.setAttribute('aria-hidden', 'true');
    photo.append(image, icon);
    article.append(photo);
    const details = [
      post.date && ['calendar-days', post.date],
      post.length && ['clock', post.length],
      post.views && ['eye', post.views],
    ].filter(Boolean);
    if (details.length) {
      const meta = document.createElement('span');
      meta.className = 'news-meta';
      details.forEach(([iconName, text]) => {
        const item = document.createElement('span');
        const icon = document.createElement('i');
        icon.className = `fa-solid fa-${iconName} icon`;
        icon.setAttribute('aria-hidden', 'true');
        item.append(icon, document.createTextNode(text));
        meta.append(item);
      });
      article.append(meta);
    }
    if (post.text) {
      const copy = document.createElement('span');
      copy.className = 'news-copy';
      copy.textContent = post.text;
      article.append(copy);
    }
    const source = document.createElement('a');
    source.className = 'btn news-facebook';
    source.href = post.href;
    source.target = '_blank';
    source.rel = 'noopener noreferrer';
    const label = document.createElement('span');
    const brand = document.createElement('i');
    brand.className = 'fa-brands fa-facebook icon';
    brand.setAttribute('aria-hidden', 'true');
    label.append(brand, document.createTextNode('View on Facebook'));
    source.append(label);
    article.append(source);
    return article;
  }

  const savedPosts = saved.map((post) => ({ ...post, id: idFrom(post.href) }));

  fetch('/api/facebook')
    .then((response) => (response.ok ? response.json() : null))
    .then((data) => {
      const live = Array.isArray(data?.posts) ? data.posts : [];
      if (!live.length || !list) return;
      const seen = new Set(live.map((post) => post.id));
      const posts = [...live, ...savedPosts.filter((post) => post.id && !seen.has(post.id))];
      posts.sort((a, b) => posted(b) - posted(a));
      list.replaceChildren(...posts.map(card));
    })
    .catch(() => {});
</script>
<script>
  import { mountPageEditor } from '../scripts/page-editor.js';

  mountPageEditor({
    photoAlbums: window.__pageAlbums || [],
    dialog: '#news-edit-dialog',
    form: '#news-edit-form',
    fields: '#news-edit-fields',
    title: '#news-edit-title',
    note: '#news-edit-note',
    status: '#news-edit-status',
    cancel: '#news-edit-cancel',
    endpoint: '/api/news-page',
    photoKey: 'news',
    bannerMark: '/news-banner.',
    dataAttr: 'data-news',
    copyTitle: 'News',
    copyNote: 'The Facebook posts stay. The button still opens Facebook.',
    bannerNote: 'The banner stays the same size. Slide the photo so faces stay in view. This quote is only on this page.',
    copyFields: [
      { key: 'title', label: 'Heading', max: 40 },
      { key: 'lead', label: 'First paragraph', max: 220, long: true },
      { key: 'account', label: 'Second paragraph', max: 160, long: true },
      { key: 'button', label: 'Button', max: 40 },
    ],
  });
</script>
