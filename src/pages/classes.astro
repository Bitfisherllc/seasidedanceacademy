---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ClassCard from '../components/ClassCard.astro';
import { pages, site } from '../data/site';
import { albums, gallery } from '../data/albums';
import { classesIn } from '../data/classes';
import classesPage from '../data/classes-page.json';
import { plainText, richHtml } from '../../api/rich-text.js';

const grow = classesIn('grow');
const ballet = classesIn('ballet');
const hipHop = classesIn('hip-hop');
const more = classesIn('more');
const classList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Dance classes at Seaside Dance Academy',
  itemListElement: [...grow, ...ballet, ...hipHop, ...more].map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Service',
      name: item.name,
      description: [item.ages, item.when, item.tuition, plainText(item.summary)].filter(Boolean).join('. '),
      provider: { '@id': new URL('/#studio', site.url).href },
      areaServed: 'Berlin, Maryland',
    },
  })),
};
const photoAlbums = [
  { title: 'Gallery', images: gallery.map((item) => item.src) },
  ...albums.map((album) => ({
    title: album.title,
    images: album.images.length ? album.images : [album.image],
  })),
];
---

<Base title={pages.classes.title} description={pages.classes.description} canonical="/classes.html">
  <Hero slot="hero" icon="person-running" image={classesPage.banner.src} focus={classesPage.banner.focus} photoKey="classes" quoteKey="classes">
    <button slot="edit" class="home-edit-btn" type="button" data-edit="banner">Edit</button>
  </Hero>
  <section class="section">
    <div class="container home-block">
      <button class="home-edit-btn" type="button" data-edit="copy">Edit</button>
      <h1 class="center">
        <span class="fs-32" data-classes="title">{classesPage.title}</span><br />
        <span class="fs-18 tone-soft" data-classes="year">{classesPage.year}</span>
      </h1>
      <ul class="fact-list fact-list-center">
        <li><i class="fa-solid fa-clipboard-check icon" aria-hidden="true"></i><span data-classes="season">{classesPage.season}</span></li>
        <li><i class="fa-solid fa-calendar-days icon" aria-hidden="true"></i><span data-classes="start">{classesPage.start}</span></li>
      </ul>
      <div class="note copy"><i class="fa-solid fa-circle-info icon" aria-hidden="true"></i><div data-classes="disclaimer" set:html={richHtml(classesPage.disclaimer)} /></div>
      <div class="gallery-tools">
        <button class="gallery-add" type="button" id="class-add">Add a class</button>
      </div>
      {grow.length > 0 && (
        <div class="class-grid">
          {grow.map((item) => (
            <div class="class-slot">
              <div class="class-tools">
                <button class="gallery-add" type="button" data-class-edit={item.id}>Edit</button>
                <button class="gallery-add" type="button" data-class-delete={item.id}>Delete</button>
              </div>
              <ClassCard item={item} register />
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
  {ballet.length > 0 && (
    <section class="section class-section">
      <div class="container">
        <h2 data-classes="balletTitle">{classesPage.balletTitle}</h2>
        <div class="copy" data-classes="balletGuide" set:html={richHtml(classesPage.balletGuide)} />
        <div class="class-grid">
          {ballet.map((item) => (
            <div class="class-slot">
              <div class="class-tools">
                <button class="gallery-add" type="button" data-class-edit={item.id}>Edit</button>
                <button class="gallery-add" type="button" data-class-delete={item.id}>Delete</button>
              </div>
              <ClassCard item={item} register />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
  {hipHop.length > 0 && (
    <section class="section class-section">
      <div class="container">
        <h2 data-classes="hipHopTitle">{classesPage.hipHopTitle}</h2>
        <div class="copy" data-classes="hipHopGuide" set:html={richHtml(classesPage.hipHopGuide)} />
        <div class="class-grid">
          {hipHop.map((item) => (
            <div class="class-slot">
              <div class="class-tools">
                <button class="gallery-add" type="button" data-class-edit={item.id}>Edit</button>
                <button class="gallery-add" type="button" data-class-delete={item.id}>Delete</button>
              </div>
              <ClassCard item={item} register />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
  {more.length > 0 && (
    <section class="section class-section">
      <div class="container">
        <div class="class-grid">
          {more.map((item) => (
            <div class="class-slot">
              <div class="class-tools">
                <button class="gallery-add" type="button" data-class-edit={item.id}>Edit</button>
                <button class="gallery-add" type="button" data-class-delete={item.id}>Delete</button>
              </div>
              <ClassCard item={item} register />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
  <dialog class="home-edit-dialog" id="classes-edit-dialog">
    <form id="classes-edit-form" onsubmit="event.preventDefault()">
      <h2 id="classes-edit-title">Edit</h2>
      <p class="home-edit-note" id="classes-edit-note"></p>
      <div id="classes-edit-fields"></div>
      <p class="home-edit-status" id="classes-edit-status" role="status"></p>
      <div class="home-edit-actions">
        <button class="home-edit-save" type="button">Save</button>
        <button class="home-edit-cancel" type="button" id="classes-edit-cancel">Cancel</button>
        <button class="home-edit-close" type="button">Close</button>
      </div>
    </form>
  </dialog>
  <dialog class="home-edit-dialog class-edit-dialog" id="class-dialog">
    <form class="contact-form" id="class-form" onsubmit="event.preventDefault()">
      <h2 id="class-dialog-title">Add a class</h2>
      <p class="home-edit-note">The card stays in the same layout. A hidden class can still be changed in the class desk.</p>
      <div class="field">
        <label class="field-label" for="class-name">Class name</label>
        <input id="class-name" name="name" required maxlength="80" />
      </div>
      <div class="field">
        <label class="field-label" for="class-ages">Ages</label>
        <input id="class-ages" name="ages" required maxlength="40" />
      </div>
      <div class="field">
        <p class="field-label" id="class-days-label">Days and times</p>
        <div id="class-sessions" aria-labelledby="class-days-label"></div>
        <button class="studio-text" type="button" id="class-add-session">Add another day</button>
      </div>
      <div class="field">
        <label class="field-label" for="class-availability">If the day is not set</label>
        <input id="class-availability" name="availability" maxlength="80" placeholder="Scheduled upon availability" />
      </div>
      <div class="name-row">
        <div class="field">
          <label class="field-label" for="class-amount">Price</label>
          <input id="class-amount" name="amount" required inputmode="decimal" maxlength="12" />
        </div>
        <div class="field">
          <label class="field-label" for="class-billing">Charged</label>
          <select id="class-billing" name="billing">
            <option value="month">Per month</option>
            <option value="hour">Per hour</option>
            <option value="half-hour">Per ½ hour</option>
          </select>
        </div>
      </div>
      <div class="field">
        <label class="field-label" for="class-group">Section</label>
        <select id="class-group" name="group" required>
          <option value="grow">Dance &amp; Grow and Pre</option>
          <option value="ballet">Ballet, jazz, and tap</option>
          <option value="hip-hop">Hip hop</option>
          <option value="more">Other classes</option>
        </select>
      </div>
      <div class="field">
        <label class="field-label" for="class-summary">Description</label>
        <textarea id="class-summary" name="summary" required maxlength="600" rows="4"></textarea>
      </div>
      <div class="field">
        <label class="field-label" for="class-recital">Recital note</label>
        <input id="class-recital" name="recital" maxlength="200" />
      </div>
      <label class="studio-check" for="class-featured">
        <input id="class-featured" name="featured" type="checkbox" />
        Show on the home page
      </label>
      <p class="home-edit-status" id="class-dialog-status" role="status"></p>
      <div class="home-edit-actions">
        <button class="home-edit-save" type="button" id="class-save">Save</button>
        <button class="home-edit-cancel" type="button" id="class-dialog-cancel">Cancel</button>
        <button class="home-edit-close" type="button">Close</button>
      </div>
    </form>
  </dialog>
  <script type="application/ld+json" set:html={JSON.stringify(classList)} />
</Base>

<script define:vars={{ photoAlbums }}>
  window.__pageAlbums = photoAlbums;
</script>
<script>
  import { mountPageEditor } from '../scripts/page-editor.js';
  import { upgradeTextarea } from '../scripts/rich-text.js';

  upgradeTextarea(document.querySelector('#class-summary'));

  const classDialog = document.querySelector<HTMLDialogElement>('#class-dialog');
  const classForm = document.querySelector<HTMLFormElement>('#class-form');
  const classTitle = document.querySelector<HTMLElement>('#class-dialog-title');
  const classStatus = document.querySelector<HTMLElement>('#class-dialog-status');
  const classSessions = document.querySelector<HTMLElement>('#class-sessions');
  const weekdays = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
  let editingClass = '';

  function classField(name: string) {
    return classForm?.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
  }

  function sessionRow(session: { day: string; start: string; end: string } = { day: 'Monday', start: '', end: '' }) {
    const row = document.createElement('div');
    row.className = 'studio-session';
    const options = weekdays
      .map((day) => `<option value="${day}"${day === session.day ? ' selected' : ''}>${day}</option>`)
      .join('');
    row.innerHTML = `<select aria-label="Day">${options}</select><label class="studio-time">Start<input type="time" data-start value="${session.start}" /></label><label class="studio-time">End<input type="time" data-end value="${session.end}" /></label><button class="studio-text" type="button" data-remove-session>Remove</button>`;
    return row;
  }

  function setSessions(sessions: { day: string; start: string; end: string }[]) {
    classSessions?.replaceChildren(...(sessions.length ? sessions : [{ day: 'Monday', start: '', end: '' }]).map((session) => sessionRow(session)));
  }

  function readSessions() {
    return [...(classSessions?.querySelectorAll<HTMLElement>('.studio-session') || [])]
      .map((row) => ({
        day: row.querySelector('select')?.value || '',
        start: row.querySelector<HTMLInputElement>('[data-start]')?.value || '',
        end: row.querySelector<HTMLInputElement>('[data-end]')?.value || '',
      }))
      .filter((session) => session.start || session.end);
  }

  async function classCatalog() {
    const response = await fetch('/api/studio-classes');
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.error || 'Sign in again.');
    return data.classes || [];
  }

  function openClassDialog(item?: {
    name: string;
    ages: string;
    sessions: { day: string; start: string; end: string }[];
    availability: string;
    amount: string;
    billing: string;
    summary: string;
    recital: string;
    group: string;
    featured: boolean;
  }) {
    if (!classDialog || !classForm) return;
    classForm.reset();
    editingClass = item ? (item as { id?: string }).id || editingClass : '';
    if (classTitle) classTitle.textContent = item ? `Edit ${item.name}` : 'Add a class';
    if (classStatus) classStatus.textContent = '';
    if (item) {
      if (classField('name')) classField('name')!.value = item.name;
      if (classField('ages')) classField('ages')!.value = item.ages;
      setSessions(item.sessions || []);
      if (classField('availability')) classField('availability')!.value = item.availability || '';
      if (classField('amount')) classField('amount')!.value = item.amount || '';
      if (classField('billing')) classField('billing')!.value = item.billing || 'month';
      if (classField('summary')) classField('summary')!.value = item.summary;
      if (classField('recital')) classField('recital')!.value = item.recital || '';
      if (classField('group')) classField('group')!.value = item.group;
      const featured = classField('featured') as HTMLInputElement | null;
      if (featured) featured.checked = item.featured;
    } else {
      setSessions([]);
    }
    const summary = classField('summary');
    if (summary instanceof HTMLTextAreaElement) summary.dispatchEvent(new Event('rich-sync'));
    classDialog.showModal();
  }

  document.querySelector('#class-add')?.addEventListener('click', () => {
    editingClass = '';
    openClassDialog();
  });

  document.querySelector('#class-dialog-cancel')?.addEventListener('click', () => classDialog?.close());

  document.querySelector('#class-add-session')?.addEventListener('click', () => {
    classSessions?.append(sessionRow());
  });

  classSessions?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest('[data-remove-session]');
    const row = button?.closest('.studio-session');
    if (!row || !classSessions) return;
    if (classSessions.querySelectorAll('.studio-session').length === 1) {
      row.querySelectorAll('input').forEach((input) => {
        input.value = '';
      });
      return;
    }
    row.remove();
  });

  document.querySelector('#class-save')?.addEventListener('click', async () => {
    if (!classStatus) return;
    const sessions = readSessions();
    if (sessions.some((session) => !session.start || !session.end)) {
      classStatus.textContent = 'Each day needs a start time and an end time.';
      return;
    }
    if (sessions.some((session) => session.end <= session.start)) {
      classStatus.textContent = 'The end time has to be later than the start time.';
      return;
    }
    const save = document.querySelector<HTMLButtonElement>('#class-save');
    if (save) save.disabled = true;
    classStatus.textContent = 'Saving…';
    try {
      const classes = await classCatalog();
      const current = classes.find((item: { id: string }) => item.id === editingClass);
      const nextItem = {
        id: editingClass,
        name: classField('name')?.value.trim() || '',
        ages: classField('ages')?.value.trim() || '',
        sessions,
        availability: classField('availability')?.value.trim() || '',
        amount: classField('amount')?.value.trim() || '',
        billing: classField('billing')?.value || 'month',
        summary: classField('summary')?.value.trim() || '',
        recital: classField('recital')?.value.trim() || '',
        group: classField('group')?.value || 'more',
        hidden: current?.hidden || false,
        featured: (classField('featured') as HTMLInputElement | null)?.checked || false,
        order: current?.order || 0,
      };
      const next = editingClass
        ? classes.map((item: { id: string }) => (item.id === editingClass ? nextItem : item))
        : [...classes, nextItem];
      const response = await fetch('/api/studio-classes', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ classes: next }),
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(payload.error || 'The class could not save.');
      window.studioSavedReload();
    } catch (error) {
      classStatus.textContent = error instanceof Error ? error.message : 'The class could not save.';
      if (save) save.disabled = false;
    }
  });

  document.querySelector('.home-block')?.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-class-edit], [data-class-delete]');
    if (!button) return;
    const id = button.dataset.classEdit || button.dataset.classDelete || '';
    if (!id) return;
    if (button.dataset.classEdit) {
      try {
        const classes = await classCatalog();
        const item = classes.find((entry: { id: string }) => entry.id === id);
        if (!item) return;
        editingClass = id;
        openClassDialog(item);
      } catch (error) {
        window.alert(error instanceof Error ? error.message : 'Sign in again.');
      }
      return;
    }
    const name = button.closest('.class-slot')?.querySelector('strong')?.textContent?.trim() || 'this class';
    if (!window.confirm(`Delete ${name}? This cannot be undone.`)) return;
    try {
      const classes = await classCatalog();
      const response = await fetch('/api/studio-classes', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ classes: classes.filter((entry: { id: string }) => entry.id !== id) }),
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(payload.error || 'The class could not be deleted.');
      window.studioSavedReload();
    } catch (error) {
      window.alert(error instanceof Error ? error.message : 'The class could not be deleted.');
    }
  });

  mountPageEditor({
    photoAlbums: window.__pageAlbums || [],
    dialog: '#classes-edit-dialog',
    form: '#classes-edit-form',
    fields: '#classes-edit-fields',
    title: '#classes-edit-title',
    note: '#classes-edit-note',
    status: '#classes-edit-status',
    cancel: '#classes-edit-cancel',
    endpoint: '/api/classes-page',
    photoKey: 'classes',
    bannerMark: '/classes-banner.',
    dataAttr: 'data-classes',
    copyTitle: 'Classes',
    copyNote: 'These lines stay above the class cards. Add, change, or delete a class with the red buttons.',
    bannerNote: 'The banner stays the same size. Slide the photo so faces stay in view. This quote is only on this page.',
    copyFields: [
      { key: 'title', label: 'Heading', max: 40 },
      { key: 'year', label: 'Season', max: 20 },
      { key: 'season', label: 'Registration line', max: 120 },
      { key: 'start', label: 'Start line', max: 80 },
      { key: 'disclaimer', label: 'Note', max: 240, long: true },
      { key: 'balletTitle', label: 'Ballet heading', max: 60 },
      { key: 'balletGuide', label: 'Ballet paragraph', max: 600, long: true },
      { key: 'hipHopTitle', label: 'Hip hop heading', max: 40 },
      { key: 'hipHopGuide', label: 'Hip hop paragraph', max: 500, long: true },
    ],
  });
</script>
