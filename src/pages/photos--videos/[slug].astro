---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import { albumDescription, albums, photoAlt } from '../../data/albums';
import { site } from '../../data/site';

export function getStaticPaths() {
  return albums.map((album) => ({
    params: { slug: album.slug },
    props: { album },
  }));
}

const { album } = Astro.props;
---

<Base
  title={`${album.title} | Seaside Dance Academy`}
  description={albumDescription(album.title, album.date)}
  canonical={`/photos--videos/${album.slug}.html`}
  crumb={album.title}
  image={album.image}
>
  <Hero slot="hero" icon="images" image="/images/hero/group-pink.jpg" focus="center" quoteKey="gallery" />
  <section class="section">
    <div class="container album-page" data-gallery={album.slug}>
      <h1 class="center">
        <span class="fs-32">{album.title}</span>
      </h1>
      <p class="copy center icon-line"><i class="fa-solid fa-calendar-days icon" aria-hidden="true"></i>{album.date}</p>
      {album.video && (
        <div class="video-frame">
          <video controls playsinline preload="metadata" poster={album.image || undefined}>
            <source src={`/videos/${album.slug}.mp4`} type="video/mp4" />
          </video>
        </div>
      )}
      <div class="gallery-tools">
        <button class="gallery-add" type="button" id="gallery-add">Add a photo</button>
      </div>
      <ul class="photo-grid" data-photo-grid>
        {album.images.map((src, index) => (
          <li class="photo-slot">
            <button class="photo-remove" type="button" data-remove={src}>Remove</button>
            <button type="button" data-photo={src} aria-label={photoAlt(album.title, src, index, album.alts)}>
              <img src={src} alt={photoAlt(album.title, src, index, album.alts)} width="480" height="360" loading="lazy" />
            </button>
          </li>
        ))}
      </ul>
      <dialog class="photo-dialog" data-photo-dialog>
        <form method="dialog">
          <button type="submit" aria-label="Close photo"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        </form>
        <img alt="" data-photo-full width="1200" height="800" />
      </dialog>
      <dialog class="home-edit-dialog" id="gallery-edit-dialog">
        <form id="gallery-edit-form">
          <h2 id="gallery-edit-title">Gallery</h2>
          <p class="home-edit-note" id="gallery-edit-note"></p>
          <div id="gallery-edit-fields"></div>
          <p class="home-edit-status" id="gallery-edit-status" role="status"></p>
          <div class="home-edit-actions">
            <button class="home-edit-save" type="button" id="gallery-edit-save">Save</button>
            <button class="home-edit-cancel" type="button" id="gallery-edit-cancel">Cancel</button>
            <button class="home-edit-close" type="button">Close</button>
          </div>
        </form>
      </dialog>
    </div>
  </section>
</Base>

<script>
  const root = document.querySelector('[data-gallery]');
  const grid = document.querySelector('[data-photo-grid]');
  const slug = root?.getAttribute('data-gallery') || '';
  const viewer = document.querySelector('[data-photo-dialog]');
  const full = viewer?.querySelector('[data-photo-full]');
  const dialog = document.querySelector('#gallery-edit-dialog');
  const fields = document.querySelector('#gallery-edit-fields');
  const title = document.querySelector('#gallery-edit-title');
  const note = document.querySelector('#gallery-edit-note');
  const status = document.querySelector('#gallery-edit-status');
  let mode = '';
  let pendingRemove = '';
  let pendingFiles = [];

  function showPhoto(src, alt) {
    if (!(viewer instanceof HTMLDialogElement) || !(full instanceof HTMLImageElement) || !src) return;
    full.src = src;
    full.alt = alt || '';
    viewer.showModal();
  }

  function photos() {
    return [...document.querySelectorAll('[data-photo]')].map((button) => button.getAttribute('data-photo')).filter(Boolean);
  }

  function openAdd() {
    mode = 'add';
    pendingRemove = '';
    pendingFiles = [];
    if (!dialog || !fields) return;
    if (title) title.textContent = 'Add a photo';
    if (note) note.textContent = 'Choose one or more JPG, PNG, or WebP photos. Each photo must be under 5 MB. Add a description, or leave it blank to use the album name.';
    if (status) status.textContent = '';
    fields.replaceChildren();
    const label = document.createElement('label');
    label.className = 'home-edit-label';
    label.append(document.createTextNode('Photos'));
    const input = document.createElement('input');
    input.type = 'file';
    input.name = 'upload';
    input.accept = 'image/jpeg,image/png,image/webp';
    input.multiple = true;
    input.required = true;
    input.addEventListener('change', () => {
      pendingFiles = [...(input.files || [])];
    });
    label.append(input);
    const altLabel = document.createElement('label');
    altLabel.className = 'home-edit-label';
    altLabel.append(document.createTextNode('Description'));
    const alt = document.createElement('textarea');
    alt.name = 'alt';
    alt.rows = 2;
    alt.maxLength = 180;
    altLabel.append(alt);
    fields.append(label, altLabel);
    dialog.showModal();
  }

  function openRemove(src) {
    mode = 'remove';
    pendingRemove = src;
    pendingFiles = [];
    if (!dialog || !fields) return;
    if (title) title.textContent = 'Remove photo';
    if (note) note.textContent = 'This photo leaves the gallery. The other photos stay.';
    if (status) status.textContent = '';
    fields.replaceChildren();
    const preview = document.createElement('div');
    preview.className = 'band-preview';
    const image = document.createElement('img');
    image.src = src;
    image.alt = document.querySelector(`[data-photo="${CSS.escape(src)}"] img`)?.alt || 'Gallery photo';
    preview.append(image);
    fields.append(preview);
    dialog.showModal();
  }

  async function post(body) {
    const response = await fetch('/api/photos-page', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const payload = await response.json();
    if (!response.ok) throw new Error(payload.error || 'The gallery could not save.');
    return payload;
  }

  function tile(src, altText) {
    const item = document.createElement('li');
    item.className = 'photo-slot';
    const remove = document.createElement('button');
    remove.type = 'button';
    remove.className = 'photo-remove';
    remove.dataset.remove = src;
    remove.textContent = 'Remove';
    const open = document.createElement('button');
    open.type = 'button';
    open.dataset.photo = src;
    const label = altText || 'Gallery photo';
    open.setAttribute('aria-label', label);
    const image = document.createElement('img');
    image.src = src.includes('/photo-') ? `${src}?v=${Date.now()}` : src;
    image.alt = label;
    image.width = 480;
    image.height = 360;
    open.append(image);
    item.append(remove, open);
    return item;
  }

  function readFile(file) {
    return new Promise((resolve, reject) => {
      if (file.size > 5 * 1024 * 1024) {
        reject(new Error('Use a photo under 5 MB.'));
        return;
      }
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result || '').split(',')[1] || '');
      reader.onerror = () => reject(new Error('That photo could not be read.'));
      reader.readAsDataURL(file);
    });
  }

  document.querySelector('#gallery-add')?.addEventListener('click', openAdd);
  document.querySelector('#gallery-edit-cancel')?.addEventListener('click', () => dialog?.close());

  grid?.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const remove = target.closest('[data-remove]');
    if (remove) {
      openRemove(remove.getAttribute('data-remove') || '');
      return;
    }
    const open = target.closest('[data-photo]');
    if (open) showPhoto(open.getAttribute('data-photo') || '', open.querySelector('img')?.alt || '');
  });

  document.querySelector('#gallery-edit-save')?.addEventListener('click', async () => {
    if (!status || !slug) return;
    const save = document.querySelector('#gallery-edit-save');
    if (save) save.disabled = true;
    status.textContent = 'Saving…';
    try {
      if (mode === 'remove') {
        const images = photos().filter((src) => src !== pendingRemove);
        await post({ photos: { slug, images } });
        document.querySelector(`[data-remove="${CSS.escape(pendingRemove)}"]`)?.closest('.photo-slot')?.remove();
        pendingRemove = '';
        window.studioSaved(dialog instanceof HTMLDialogElement ? dialog : null);
      } else if (mode === 'add') {
        if (!pendingFiles.length) throw new Error('Choose a photo to add.');
        const altInput = fields?.querySelector('textarea[name="alt"]');
        const altText = altInput instanceof HTMLTextAreaElement ? altInput.value.trim() : '';
        const heading = document.querySelector('h1')?.textContent?.replace(/\s+/g, ' ').trim() || 'Gallery';
        let images = photos();
        for (const file of pendingFiles) {
          const data = await readFile(file);
          const payload = await post({
            photos: { slug, images, ...(altText ? { alt: altText } : {}) },
            image: { kind: 'gallery', slug, type: file.type, data },
          });
          const saved = payload.page?.albums?.[slug]?.images || [];
          const src = saved[saved.length - 1];
          if (src && !images.includes(src)) {
            images = [...images, src];
            grid?.append(tile(src, altText || `${heading}, photo ${images.length}`));
          }
        }
        pendingFiles = [];
        window.studioSaved(dialog instanceof HTMLDialogElement ? dialog : null);
      }
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'The gallery could not save.';
    } finally {
      if (save) save.disabled = false;
    }
  });
</script>
