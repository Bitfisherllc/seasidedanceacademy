<button class="to-top" type="button" aria-label="Back to top" hidden>
  <svg class="to-top-icon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 5.2 5.1 12.1l1.7 1.7L11 9.6V19h2V9.6l4.2 4.2 1.7-1.7L12 5.2Z" />
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('.to-top');
  if (button) {
    const update = () => {
      button.hidden = window.scrollY < 480;
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    button.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  }
</script>
