---
const { slides } = Astro.props;
---

<div class="slideshow-frame" data-slideshow data-index="0">
  <button class="home-edit-btn" type="button" data-edit="slides">Edit</button>
  {slides.map((photo, index) => (
    <a class:list={['slide-link', { 'is-active': index === 0 }]} href="/photos--videos.html">
      <img src={photo.src} alt={photo.alt || 'Seaside Dance Academy dancers performing on stage'} width="1100" height="733" style={`object-position: ${photo.focus}`} data-focus={photo.focus} loading="lazy" />
    </a>
  ))}
  <button class="slide-btn slide-prev" type="button" aria-label="Previous photo"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
  <button class="slide-btn slide-next" type="button" aria-label="Next photo"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
</div>

<script>
  const frame = document.querySelector('[data-slideshow]');
  if (frame) {
    const show = (next) => {
      const slides = [...frame.querySelectorAll('.slide-link')];
      if (!slides.length) return;
      const index = (next + slides.length) % slides.length;
      frame.dataset.index = String(index);
      slides.forEach((slide, item) => slide.classList.toggle('is-active', item === index));
    };
    frame.querySelector('.slide-prev')?.addEventListener('click', () => show(Number(frame.dataset.index || 0) - 1));
    frame.querySelector('.slide-next')?.addEventListener('click', () => show(Number(frame.dataset.index || 0) + 1));
  }
</script>
