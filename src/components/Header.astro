---
import { nav, site } from '../data/site';

const raw = Astro.url.pathname;
const current = raw.replace(/\/index\.html$/, '/').replace(/\.html$/, '').replace(/\/$/, '') || '/';
const menu = [
  ...nav.filter((item) => item.href !== '/registration.html' && item.href !== '/contact.html'),
  { href: '/directions.html', label: 'Directions', icon: 'diamond-turn-right', brand: false },
];

function isCurrent(href: string) {
  const normalized = href.replace(/\.html$/, '').replace(/\/$/, '') || '/';
  if (normalized === '/') return current === '/';
  return current === normalized || current.startsWith(`${normalized}/`);
}
---

<div class="mobile-nav" id="mobile-nav" aria-hidden="true" inert>
  <nav aria-label="Mobile">
    <ul>
      {menu.map((item) => (
        <li>
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            <i class={`${item.brand ? 'fa-brands' : 'fa-solid'} fa-${item.icon} icon`} aria-hidden="true"></i>{item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>
<button class="nav-overlay" type="button" tabindex="-1" aria-label="Close menu"></button>

<header class="site-header">
  <div class="brand">
    <div class="container brand-inner">
      <a class="brand-logo" href="/">
        <img src="/images/logos/mark.svg" alt="" width="100" height="88" />
        <span class="brand-name">Seaside Dance Academy</span>
      </a>
      <div class="brand-actions">
        <a class="btn header-btn" href={`tel:${site.phoneTel}`}><span><i class="fa-solid fa-phone icon" aria-hidden="true"></i>Call</span></a>
        <a class="btn header-btn" href="/contact.html"><span><i class="fa-solid fa-envelope icon" aria-hidden="true"></i>Contact</span></a>
        <a class="btn header-btn header-admin" href="/studio.html" aria-label="Admin"><span><i class="fa-solid fa-user-gear icon" aria-hidden="true"></i></span></a>
      </div>
    </div>
  </div>
  <div class="nav-bar">
    <div class="container nav-inner">
      <a class="mobile-brand" href="/">
        <img src="/images/logos/mark.svg" alt="Seaside Dance Academy" width="39" height="34" />
      </a>
      <div class="mobile-actions">
        <a class="btn header-btn" href={`tel:${site.phoneTel}`}><span><i class="fa-solid fa-phone icon" aria-hidden="true"></i>Call</span></a>
        <a class="btn header-btn" href="/contact.html"><span><i class="fa-solid fa-envelope icon" aria-hidden="true"></i>Contact</span></a>
        <a class="btn header-btn header-admin" href="/studio.html" aria-label="Admin"><span><i class="fa-solid fa-user-gear icon" aria-hidden="true"></i></span></a>
      </div>
      <nav class="desktop-nav" aria-label="Primary">
        <ul>
          {menu.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                <i class={`${item.brand ? 'fa-brands' : 'fa-solid'} fa-${item.icon} icon`} aria-hidden="true"></i>{item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <form class="search" action="/apps/search" method="get" role="search">
        <label class="visually-hidden" for="site-search">Search</label>
        <input id="site-search" type="search" name="q" placeholder="Search" autocomplete="off" />
        <button type="submit" aria-label="Search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
      </form>
      <button class="hamburger" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <span></span>
      </button>
    </div>
  </div>
  <div class="admin-bar" hidden>
    <label class="admin-switch">
      <input class="visually-hidden" type="checkbox" id="admin-visitor" />
      <span class="admin-switch-ui" aria-hidden="true"></span>
      View as visitor
    </label>
    <button class="admin-bar-btn" type="button" id="admin-help">How to use admin</button>
    <a class="admin-bar-btn" href="/studio.html#colors">Colors</a>
    <button class="admin-bar-btn" type="button" id="admin-logout">Log out</button>
  </div>
  <dialog class="admin-help" id="admin-help-dialog">
    <form method="dialog">
      <button type="submit" aria-label="Close"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
    </form>
    <h2>How to use admin</h2>
    <ul>
      <li>Red Edit buttons change the words or photo in that spot. The layout stays the same.</li>
      <li>Paragraph boxes have bold, italic, underline, line breaks, lists, and links. Headings, button labels, quotes, hours, and photo descriptions stay plain text.</li>
      <li>On the home page, Edit on the top banner changes the photo, the season line, and the three boxes. Those boxes still open the same pages.</li>
      <li>Edit on Welcome changes the headings, the paragraph, and the call label. The phone number stays the studio number.</li>
      <li>Edit on The studio changes the headings, the four paragraphs, and the four points under them.</li>
      <li>The top banner plays as a slideshow. Edit on that banner changes the opening photo, the season line, and the three boxes. Edit on the slideshow changes the photos that follow, and those photos also play beside the welcome text. Each photo has a description.</li>
      <li>Edit on the home page classes section changes the heading, the two lines, and the button. Change the class cards on the Classes page.</li>
      <li>Edit on Studio director changes the photo, the heading, the name, and the two paragraphs.</li>
      <li>Each page banner has its own quote. Edit on that banner changes only that quote. Gallery pages share one quote. The home page banner does not use one.</li>
      <li>On Classes, Edit changes the banner photo and the words above the cards, including the ballet and hip hop headings.</li>
      <li>Add a class, Edit, and Delete change a class. A class needs a name, ages, a day with a start and end time or a note when the day is not set, a price per month, per hour, or per half hour, a section, and a description. Show on the home page puts that class on the home page.</li>
      <li>Open the class desk to hide a class or move it up or down. A hidden class stays in the desk and leaves the public schedule, the home page, search, and registration.</li>
      <li>On Seaside News, Edit changes the banner, the heading, the two paragraphs, and the button label. The Facebook posts stay, and the button still opens Facebook.</li>
      <li>On Photos &amp; Videos, Edit changes the banner, the page heading, and an album’s title, date, and cover. Add a gallery starts a new album. Inside a gallery, Add a photo can include a description, and Remove takes a picture out. The Instagram pictures come from Instagram.</li>
      <li>On Reviews, Edit changes the banner, the headings, the paragraph, and the two button labels. The Google rating and written reviews stay, and both buttons still open Google.</li>
      <li>On Directions, Edit changes the banner, the heading, the paragraph, the button label, and the hours. The address, phone, email, and map stay, and Get directions still opens Google Maps.</li>
      <li>On Q &amp; A, Edit changes the banner and the introduction. Add a question, Edit, and Delete change the questions and answers.</li>
      <li>On Contact, Registration, Instagram, and inside a gallery, Edit on the banner changes that page’s quote. A gallery quote appears on every gallery page.</li>
      <li>Colors on the class desk changes the main site colors. Use Seaside colors puts this original scheme back.</li>
      <li>View as visitor hides the editing buttons and brings the admin button back. This bar stays so you can switch back.</li>
      <li>Log out ends the session on this browser.</li>
      <li>On the live site, a save shows up after the site rebuilds.</li>
    </ul>
    <p><a class="btn" href="/studio.html"><span><i class="fa-solid fa-user-gear icon" aria-hidden="true"></i>Class desk</span></a></p>
  </dialog>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.hamburger');
  const overlay = document.querySelector<HTMLButtonElement>('.nav-overlay');
  const panel = document.getElementById('mobile-nav');

  function setOpen(open: boolean) {
    document.body.classList.toggle('nav-open', open);
    button?.setAttribute('aria-expanded', String(open));
    button?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (panel) {
      panel.toggleAttribute('inert', !open);
      panel.setAttribute('aria-hidden', String(!open));
    }
    if (open) panel?.querySelector('a')?.focus();
  }

  button?.addEventListener('click', () => {
    setOpen(!document.body.classList.contains('nav-open'));
  });
  overlay?.addEventListener('click', () => setOpen(false));
  panel?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });

  const siteHeader = document.querySelector('.site-header');
  let headerStuck = false;
  const markStuck = () => {
    const y = window.scrollY;
    headerStuck = headerStuck ? y > 8 : y > 80;
    siteHeader?.classList.toggle('is-stuck', headerStuck);
  };
  markStuck();
  window.addEventListener('scroll', markStuck, { passive: true });

  const brandLogo = document.querySelector<HTMLElement>('.brand-logo');
  const homeItem = document.querySelector<HTMLElement>('.desktop-nav li');
  const alignBrand = () => {
    if (!brandLogo || !homeItem) return;
    brandLogo.style.marginLeft = '0px';
    if (getComputedStyle(homeItem).position !== 'absolute') {
      brandLogo.style.marginLeft = '';
      return;
    }
    const delta = homeItem.getBoundingClientRect().left - brandLogo.getBoundingClientRect().left;
    brandLogo.style.marginLeft = `${Math.round(delta)}px`;
  };
  alignBrand();
  window.addEventListener('resize', alignBrand);
  document.fonts?.ready.then(alignBrand);

  const adminBar = document.querySelector<HTMLElement>('.admin-bar');
  const visitorToggle = document.querySelector<HTMLInputElement>('#admin-visitor');
  const helpDialog = document.querySelector<HTMLDialogElement>('#admin-help-dialog');
  const visitorKey = 'studio-visitor';
  const onDesk = () => location.pathname.replace(/\.html$/, '').endsWith('/studio');

  function showAdmin(signedIn: boolean) {
    const preview = signedIn && sessionStorage.getItem(visitorKey) === '1' && !onDesk();
    document.body.classList.toggle('studio-in', signedIn);
    document.body.classList.toggle('studio-visitor', preview);
    if (adminBar) adminBar.hidden = !signedIn;
    if (visitorToggle) visitorToggle.checked = preview;
    placeAdminBar();
  }

  function placeAdminBar() {
    const height = adminBar && !adminBar.hidden ? adminBar.offsetHeight : 0;
    document.documentElement.style.setProperty('--admin-bar-h', `${height}px`);
  }

  async function refreshAdmin() {
    try {
      const response = await fetch('/api/studio-classes');
      showAdmin(response.ok);
    } catch {
      showAdmin(false);
    }
  }

  visitorToggle?.addEventListener('change', () => {
    if (visitorToggle.checked) {
      sessionStorage.setItem(visitorKey, '1');
      if (onDesk()) {
        location.href = '/';
        return;
      }
      showAdmin(true);
      return;
    }
    sessionStorage.removeItem(visitorKey);
    showAdmin(true);
  });

  document.querySelector('#admin-help')?.addEventListener('click', () => {
    helpDialog?.showModal();
  });

  document.querySelector('#admin-logout')?.addEventListener('click', async () => {
    await fetch('/api/studio-classes', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'logout' }),
    });
    sessionStorage.removeItem(visitorKey);
    location.reload();
  });

  document.querySelectorAll<HTMLAnchorElement>('.header-admin').forEach((link) => {
    link.addEventListener('click', () => sessionStorage.removeItem(visitorKey));
  });

  window.addEventListener('studio-session', () => {
    refreshAdmin();
  });

  if (onDesk()) sessionStorage.removeItem(visitorKey);
  if (adminBar && 'ResizeObserver' in window) {
    new ResizeObserver(placeAdminBar).observe(adminBar);
  }
  refreshAdmin();
</script>
