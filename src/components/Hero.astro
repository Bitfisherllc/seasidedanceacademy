---
import heroCopy from '../data/hero.json';

interface Slide {
  src: string;
  focus?: string;
  alt?: string;
}

interface Props {
  icon: string;
  home?: boolean;
  brand?: boolean;
  image?: string;
  focus?: string;
  slides?: Slide[];
  photoKey?: string;
  quoteKey?: string;
}

const {
  icon,
  home = false,
  brand = false,
  image = '/images/hero/duo-blue.jpg',
  focus = 'center',
  slides = [],
  photoKey,
  quoteKey = '',
} = Astro.props;
const heroSlides = home
  ? [{ src: image, focus, alt: '' }, ...slides.filter((slide) => slide.src && slide.src !== image)]
  : [{ src: image, focus, alt: '' }];
const quotes = heroCopy as Record<string, string>;
const quote = quotes[quoteKey] || '';
const quoteOnly = !home && !Astro.slots.has('edit');
const quoteNote = quoteKey === 'gallery'
  ? 'This quote is on every gallery page.'
  : 'This quote is only on this page.';
---

<section class:list={['hero', { 'hero-home': home }]} aria-label="Seaside Dance Academy">
  <div class="hero-parallax" data-hero-slideshow={home ? '' : undefined}>
    {heroSlides.map((photo, index) => (
      <img
        class:list={['hero-bg', { 'is-active': index === 0 }]}
        src={photo.src}
        alt=""
        width="1100"
        height="733"
        style={`object-position: ${photo.focus || 'center'}`}
        data-home-photo={index === 0 ? photoKey || (home ? 'hero.image' : undefined) : undefined}
        data-focus={photo.focus || 'center 50%'}
        fetchpriority={index === 0 ? 'high' : undefined}
        loading={index === 0 ? 'eager' : 'lazy'}
        decoding="async"
      />
    ))}
  </div>
  {home && heroSlides.length > 1 && (
    <>
      <button class="slide-btn slide-prev hero-slide-btn" type="button" data-hero-prev aria-label="Previous photo"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
      <button class="slide-btn slide-next hero-slide-btn" type="button" data-hero-next aria-label="Next photo"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
    </>
  )}
  <div class="hero-shade"></div>
  <svg class="hero-wave" viewBox="0 0 1440 140" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="hero-wave-green" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--header)"></stop>
        <stop offset="100%" stop-color="var(--green)"></stop>
      </linearGradient>
    </defs>
    <path fill="#ffffff" opacity="0.18" d="M0 46C220 96 460 18 740 58C1020 98 1220 28 1440 62L1440 140L0 140Z"></path>
    <path fill="#ffffff" opacity="0.38" d="M0 72C200 112 440 48 720 82C1000 116 1220 70 1440 90L1440 140L0 140Z"></path>
    <path fill="url(#hero-wave-green)" d="M0 96C240 122 480 74 760 104C1040 132 1240 96 1440 112L1440 140L0 140Z"></path>
  </svg>
  {Astro.slots.has('edit') && (
    <div class="home-edit-spot">
      <slot name="edit" />
    </div>
  )}
  {quoteOnly && (
    <div class="home-edit-spot">
      <button class="home-edit-btn" type="button" id="hero-quote-edit">Edit</button>
    </div>
  )}
  <div class="hero-inner">
    {!home && (
      <div class="hero-split">
        <i class={`${brand ? 'fa-brands' : 'fa-solid'} fa-${icon} hero-icon`} aria-hidden="true"></i>
        <div>
          <blockquote class="hero-quote">
            <p>“<span data-hero-quote data-hero-key={quoteKey}>{quote}</span>”</p>
          </blockquote>
        </div>
      </div>
    )}
    <slot />
  </div>
  {quoteOnly && (
    <dialog class="home-edit-dialog" id="hero-quote-dialog">
      <form id="hero-quote-form">
        <h2>Quote</h2>
        <p class="home-edit-note">{quoteNote}</p>
        <div id="hero-quote-fields"></div>
        <p class="home-edit-status" id="hero-quote-status" role="status"></p>
        <div class="home-edit-actions">
          <button class="home-edit-save" type="button" id="hero-quote-save">Save</button>
          <button class="home-edit-cancel" type="button" id="hero-quote-cancel">Cancel</button>
          <button class="home-edit-close" type="button">Close</button>
        </div>
      </form>
    </dialog>
  )}
</section>

<script>
  import { appendQuoteField, saveHeroQuote } from '../scripts/page-editor.js';

  const quoteDialog = document.querySelector<HTMLDialogElement>('#hero-quote-dialog');
  const quoteFields = document.querySelector<HTMLElement>('#hero-quote-fields');
  const quoteStatus = document.querySelector<HTMLElement>('#hero-quote-status');

  document.querySelector('#hero-quote-edit')?.addEventListener('click', () => {
    if (!quoteDialog || !quoteFields) return;
    if (quoteStatus) quoteStatus.textContent = '';
    quoteFields.replaceChildren();
    appendQuoteField(quoteFields);
    quoteDialog.showModal();
  });

  document.querySelector('#hero-quote-cancel')?.addEventListener('click', () => quoteDialog?.close());

  document.querySelector('#hero-quote-save')?.addEventListener('click', async () => {
    const input = quoteDialog?.querySelector<HTMLTextAreaElement>('textarea[name="heroQuote"]');
    const save = document.querySelector<HTMLButtonElement>('#hero-quote-save');
    if (!input || !quoteStatus) return;
    if (save) save.disabled = true;
    quoteStatus.textContent = 'Saving…';
    try {
      const payload = await saveHeroQuote(input.value);
      window.studioSaved(quoteDialog);
    } catch (error) {
      quoteStatus.textContent = error instanceof Error ? error.message : 'The quote could not save.';
    } finally {
      if (save) save.disabled = false;
    }
  });

  const hero = document.querySelector<HTMLElement>('.hero');
  const layer = hero?.querySelector<HTMLElement>('.hero-parallax');
  const shade = hero?.querySelector<HTMLElement>('.hero-shade');
  const foreground = hero?.querySelector<HTMLElement>('.hero-inner');
  const bands = [...document.querySelectorAll<HTMLImageElement>('.home-band img')];
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function placeBands() {
    bands.forEach((img) => {
      const band = img.parentElement;
      if (!band || motion.matches) {
        img.style.transform = '';
        return;
      }
      const rect = band.getBoundingClientRect();
      const progress = Math.min(1, Math.max(0, (window.innerHeight - rect.top) / (window.innerHeight + rect.height)));
      const shift = (progress - 0.5) * 16;
      img.style.transform = `translate3d(0, ${shift.toFixed(2)}px, 0)`;
    });
  }

  function place() {
    placeBands();
    if (!hero || !layer) return;
    if (motion.matches) {
      layer.style.transform = '';
      layer.style.opacity = '';
      if (shade) shade.style.opacity = '';
      if (foreground) foreground.style.transform = '';
      return;
    }
    const rect = hero.getBoundingClientRect();
    const progress = Math.min(1, Math.max(0, (window.innerHeight - rect.top) / (window.innerHeight + rect.height)));
    const fade = Math.min(1, Math.max(0, -rect.top / hero.offsetHeight));
    const opacity = (1 - fade).toFixed(3);
    layer.style.opacity = opacity;
    if (shade) shade.style.opacity = opacity;
    if (foreground) {
      const lift = (0.5 - progress) * hero.offsetHeight * 0.18;
      foreground.style.transform = `translate3d(0, ${lift.toFixed(2)}px, 0)`;
    }
    if (window.innerWidth < 768) {
      layer.style.transform = '';
      return;
    }
    const shift = (progress - 0.5) * hero.offsetHeight * 0.45;
    layer.style.transform = `translate3d(0, ${shift.toFixed(2)}px, 0)`;
  }

  let frame = 0;
  function request() {
    if (frame) return;
    frame = requestAnimationFrame(() => {
      frame = 0;
      place();
    });
  }

  place();
  window.addEventListener('scroll', request, { passive: true });
  window.addEventListener('resize', request);
  motion.addEventListener('change', place);

  const homeHero = document.querySelector<HTMLElement>('.hero-home');
  let heroIndex = 0;
  let heroTimer = 0;

  function heroFrames() {
    return homeHero ? [...homeHero.querySelectorAll<HTMLImageElement>('.hero-bg')] : [];
  }

  function showHero(next: number) {
    const frames = heroFrames();
    if (frames.length < 2) return;
    heroIndex = (next + frames.length) % frames.length;
    frames.forEach((frame, index) => frame.classList.toggle('is-active', index === heroIndex));
  }

  function queueHero() {
    window.clearInterval(heroTimer);
    if (heroFrames().length < 2 || motion.matches || document.hidden) return;
    heroTimer = window.setInterval(() => showHero(heroIndex + 1), 5000);
  }

  homeHero?.querySelector('[data-hero-prev]')?.addEventListener('click', () => {
    showHero(heroIndex - 1);
    queueHero();
  });
  homeHero?.querySelector('[data-hero-next]')?.addEventListener('click', () => {
    showHero(heroIndex + 1);
    queueHero();
  });
  document.addEventListener('visibilitychange', queueHero);
  motion.addEventListener('change', queueHero);
  window.addEventListener('hero-slides-changed', () => {
    heroIndex = 0;
    showHero(0);
    queueHero();
  });
  queueHero();
</script>
