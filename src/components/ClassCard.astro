---
import type { DanceClass } from '../data/classes';

interface Props {
  item: DanceClass;
  link?: boolean;
  register?: boolean;
}

const { item, link = false, register = false } = Astro.props;
const Tag = link ? 'a' : 'article';
const facts = [
  { icon: 'child', text: item.ages },
  ...(item.days ? [{ icon: 'calendar-days', text: item.days }] : []),
  ...item.sessions.map((session) => ({ icon: 'clock', text: `${session.day}, ${session.time}` })),
  ...(!item.sessions.length && item.availability ? [{ icon: 'clock', text: item.availability }] : []),
  { icon: 'dollar-sign', text: item.tuition },
];
---

<Tag class="class-card" href={link ? `/classes.html#${item.id}` : undefined} id={link ? undefined : item.id}>
  <strong>{item.name}</strong>
  <ul class="fact-list">
    {facts.map((fact) => (
      <li><i class={`fa-solid fa-${fact.icon} icon`} aria-hidden="true"></i>{fact.text}</li>
    ))}
  </ul>
  <p class="copy">{item.summary}</p>
  {item.recital && <p class="copy recital-note"><i class="fa-solid fa-music icon" aria-hidden="true"></i>{item.recital}</p>}
  {register && (
    <a class="btn class-register" href={`/registration.html?class=${item.id}#registration-form`}>
      <span><i class="fa-solid fa-clipboard-list icon" aria-hidden="true"></i>Register</span>
    </a>
  )}
</Tag>
