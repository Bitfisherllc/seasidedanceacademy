# Cloudflare Turnstile protects the contact and registration forms.
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Add both values on the host (Vercel → Settings → Environment Variables).
# The site key is public. Do not commit the secret.

PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Local development can use Cloudflare's dummy keys. The widget says "testing only".
# PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Class desk password for studio staff. Required on Vercel.
STUDIO_PASSWORD=

# Lets the class desk save on the live site. The token needs Contents
# read and write on this repository. A save updates the repo and Vercel rebuilds.
GITHUB_TOKEN=
GITHUB_REPO=Bitfisherllc/seasidedanceacademy
GITHUB_BRANCH=main

# Live Google reviews. Uses Places API (New) for the studio listing.
# Without this key, the Reviews page shows the saved reviews.
GOOGLE_PLACES_API_KEY=
